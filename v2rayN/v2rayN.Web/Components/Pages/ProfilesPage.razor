@page "/profiles"
@inherits ReactiveComponentBase<ProfilesViewModel>

<PageTitle>ProfilesPage</PageTitle>

<MudContainer>
    <MudText Typo="Typo.h6">Profiles Page</MudText>

    <!-- Tool -->
    <MudItem xs="12">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@AddProfileTest">
                Add Profile
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="@RefreshProfiles">
                Refresh
            </MudButton>
        </MudStack>
    </MudItem>

    <MudItem xs="12">
        <MudDataGrid T="ProfileItemModel"
                     Items="@ViewModel!.ProfileItems"
                     MultiSelection="true"
                     SelectOnRowClick="false"
                     @bind-SelectedItems="selectedItems"
                     Virtualize="true"
                     Hover="true"
                     Dense="false"
                     FixedHeader="true"
                     Height="400px"
                     ItemSize="52.68f"
                     ColumnResizeMode="ResizeMode.Container">

            <ToolBarContent>
                <MudText Typo="Typo.h6">Profiles List</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="ViewModel!.ServerFilter"
                              Label="Search"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              DebounceInterval="300"
                              Style="max-width: 300px;"
                              TextUpdateSuppression="false"
                              OnKeyDown="@OnServerFilterKeyDown" />
            </ToolBarContent>
            <Columns>
                <SelectColumn T="ProfileItemModel" />

                <TemplateColumn CellClass="justify-start">
                    <CellTemplate Context="context">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           Title="@ResUI.menuSetDefaultServer"
                                           OnClick="@(() => SetDefaultServer(context.Item))" />

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Title="@ResUI.menuEditServer" />

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Title="@ResUI.menuRemoveServer"
                                           OnClick="@(() => RemoveProfile(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Title="@ResUI.LvServiceType" Property="x => x.ConfigType" />

                <TemplateColumn Title="@ResUI.LvRemarks" CellClass="justify-start">
                    <CellTemplate Context="context">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            @if (context.Item == ViewModel.SelectedProfile)
                            {
                                <MudChip Color="Color.Info"
                                         Variant="Variant.Filled"
                                         Size="Size.Small"
                                         Class="ml-2">Actived</MudChip>
                            }
                            <MudText>@context.Item.Remarks</MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Title="@ResUI.LvAddress" Property="x => x.Address" />
                <PropertyColumn Title="@ResUI.LvPort" Property="x => x.Port" />
                <PropertyColumn Title="@ResUI.LvTransportProtocol" Property="x => x.Network" />
                <PropertyColumn Title="@ResUI.LvTLS" Property="x => x.StreamSecurity" />
                <PropertyColumn Title="@ResUI.LvSubscription" Property="x => x.SubRemarks" />

                <TemplateColumn Title="@ResUI.LvTestDelay" CellClass="justify-start">
                    <CellTemplate Context="context">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            @if (context.Item.Delay > 0)
                            {
                                <MudText>@context.Item.Delay</MudText>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>

                <!-- etc. -->

            </Columns>
        </MudDataGrid>
    </MudItem>

    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                   Color="Color.Error"
                   Size="Size.Medium"
                   Title="@ResUI.menuRemoveServer"
                   OnClick="@RemoveProfiles" />
</MudContainer>
